# Configuração da Loja Aurora. Copie para .env e troque os valores: o .env fica fora do git.

# Tudo que começa com PUBLIC_ vai para o navegador, em /config.js.
PUBLIC_LOJA_NOME=Loja Aurora
PUBLIC_PAGAMENTO_CHAVE_PUBLICA=aurora_pk_teste_7Qm2Lx9Vb4Rt1Nc8

# Só no servidor. No .env, a chave secreta do gateway; aqui, só o nome da variável.
PAGAMENTO_CHAVE_SECRETA=

# Segredo combinado com o gateway de pagamento para assinar o webhook.
WEBHOOK_SEGREDO=troque-pelo-segredo-combinado-com-o-gateway
